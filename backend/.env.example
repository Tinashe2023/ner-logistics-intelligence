# Copy this file to .env (same folder) and fill in your real Neon connection
# string. .env is gitignored — never commit real credentials.
# Leave unset / delete this file entirely to fall back to local SQLite.
DATABASE_URL=postgresql://user:password@ep-xxx.aws.neon.tech/dbname?sslmode=require

# Comma-separated browser origins allowed to call this API.
FRONTEND_ORIGINS=http://localhost:5173,https://ner-logistics-intelligence-nine.vercel.app

# Backblaze B2 S3-compatible API (keep these values in ignored backend/.env)
B2_BUCKET_NAME=ner-logistics-hub
B2_REGION=us-east-005
B2_KEY_ID=replace-with-bucket-restricted-key-id
B2_APPLICATION_KEY=replace-with-application-key
