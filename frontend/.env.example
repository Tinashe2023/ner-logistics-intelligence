# Copy to .env.local for local overrides, or set this in Vercel's project
# settings (Environment Variables) once the backend is deployed.
# Leave unset locally — api.js falls back to http://localhost:8000/api.
VITE_API_BASE_URL=https://ner-logistics-intelligence-akhd.onrender.com/api

# CARTO Voyager basemap key. Set this in frontend/.env.local for local use
# and in your frontend host's environment settings for deployed builds.
VITE_CARTO_API_KEY=your_carto_api_key
